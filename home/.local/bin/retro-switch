#!/bin/bash
# Toggle between Omarchy (Hyprland) and the retro IceWM session.
# Usage: retro-switch [icewm|omarchy]   (no arg = switch to the other one)
target="${1:-}"
if [[ -z $target ]]; then
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then target=icewm; else target=omarchy; fi
fi
command -v notify-send >/dev/null && notify-send "Switching to $target…" 2>/dev/null
sudo -n /usr/local/bin/desktop-session-set "$target"
