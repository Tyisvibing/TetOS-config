pkgname=knobs
pkgver=0.1.0
pkgrel=1
pkgdesc='Any config file as a settings menu, explained from its own documentation'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
optdepends=('claude-code: reads the documentation and explains each setting')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/knobs "$pkgdir/usr/bin/knobs"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/knobs.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/knobs.svg"
  install -Dm644 "$startdir/knobs.desktop" "$pkgdir/usr/share/applications/knobs.desktop"
}
