        <file alias="HelpOverlay.qml">HelpOverlay.qml</file>
        <file alias="StartPane.qml">StartPane.qml</file>
        <file alias="i18n/en.json">i18n/en.json</file>
        <file alias="i18n/da.json">i18n/da.json</file>
        <file alias="i18n/de.json">i18n/de.json</file>
        <file alias="i18n/es.json">i18n/es.json</file>
    </qresource>
</RCC>
